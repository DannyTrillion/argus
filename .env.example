# CoinMarketCap Pro API key (get one at https://pro.coinmarketcap.com). Never commit the real key.
CMC_API_KEY=
# Anthropic API key for the Claude agent. Never commit the real key.
# Optional: without it, visitors bring their own key on /keys (the scheduled brief and
# watch loop stay off, since they need a server-side key).
ANTHROPIC_API_KEY=
# Optional: port for the web UI (default 3000)
PORT=3100
# Model for questions you ask (default claude-opus-5) and for unattended work (default claude-sonnet-5).
ARGUS_MODEL=
ARGUS_AUTOMATION_MODEL=
# Watch loop: scheduled scan interval (default 240 = every 4h) and daily cap for the server key. Manual scans need a visitor's own key.
WATCH_INTERVAL_MINUTES=240
WATCH_MAX_PER_DAY=3
# Set to 1 to start with automation paused (brief + watch loop). Toggle at runtime on /status.
AUTOMATION_PAUSED=
# Optional owner token. When set, pausing automation and forcing a brief need it (x-admin-token).
ARGUS_ADMIN_TOKEN=
# Brief schedule in minutes (default 720 = twice a day).
BRIEF_REFRESH_MINUTES=720
# Caps on analyst questions using the site's shared key (visitors' own keys are not capped).
ANALYST_SHARED_PER_HOUR=6
ANALYST_SHARED_PER_DAY=40
# Findings older than this leave the Home carousel.
STORY_MAX_AGE_HOURS=48
# CoinMarketCap budget. Lean mode switches on by itself on a Basic-sized plan (15,000 credits);
# set CMC_LEAN=1 to force it or 0 to disable. BUDGET_UNTIL spreads the monthly credits until that date.
CMC_LEAN=
BUDGET_UNTIL=2026-10-19T00:00:00Z
# Rehearsal: behave as if the key were on the free Basic plan (liquidations and news blocked, 15k credits).
CMC_SIMULATE_BASIC=
